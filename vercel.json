{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "",
  "buildCommand": "",
  "outputDirectory": ".",
  "rewrites": [
    { "source": "/node_modules/.pnpm/([^/]+)/node_modules/(.*)", "destination": "/vendor/lib/$1/files/$2" }
  ],
  "headers": [
    {
      "source": "/:path*.(png|jpg|jpeg|webp|gif|svg|avif|woff|woff2|ttf|otf|mp3|ogg|wav|m4a|mp4|webm)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
